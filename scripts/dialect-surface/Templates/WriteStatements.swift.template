// MARK: - Delete


extension XLDeleteTableStatement where Dialect == {{Dialect}} {

    ///
    /// Adds a where clause to the delete statement.
    ///
    public func `where`<U>(_ expression: any {{Expression}}<U>) -> XLDeleteWhereStatement<Table, {{Dialect}}> where U: XLBoolean {
        XLDeleteWhereStatement(components: components.appending(Where<{{Dialect}}>(_dialectSurface: expression)))
    }
}
