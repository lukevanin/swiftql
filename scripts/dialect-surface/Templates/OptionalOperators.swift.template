import Foundation


extension {{Expression}} {
 
    public func coalesce<Wrapped>(_ expression: any {{Expression}}<Wrapped>) -> some {{Expression}}<Wrapped> where T == Optional<Wrapped> {
        XLNullCoalesceExpression(lhs: self, rhs: expression)
    }
    
    public static func ??<Wrapped>(lhs: Self, rhs: any {{Expression}}<Wrapped>) -> some {{Expression}}<Wrapped> where T == Optional<Wrapped> {
        XLNullCoalesceExpression(lhs: lhs, rhs: rhs)
    }
}


// MARK: - isNull

extension {{Expression}} {
    
    public func isNull<Wrapped>() -> some {{Expression}}<Bool> where T == Optional<Wrapped> {
        XLNullTestExpression(.isNull, operand: self)
    }
}


// MARK: - notNull

extension {{Expression}} {
    
    public func notNull() -> some {{Expression}}<Bool> where T: ExpressibleByNilLiteral {
        XLNullTestExpression(.isNotNull, operand: self)
    }
}
