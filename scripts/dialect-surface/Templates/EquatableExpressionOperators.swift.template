import Foundation


// MARK: - Equality
//
// An optional operand makes the result `Optional<Bool>`: SQL's `=` and `<>`
// yield `NULL` when either operand is `NULL`, as the ordering operators do. To
// compare `NULL` as a value, use `isNotDistinctFrom(_:)` and
// `isDistinctFrom(_:)` below (issue #692).


public func ==<T>(lhs: any {{Expression}}<T>, rhs: any {{Expression}}<T>) -> some {{Expression}}<Bool> where T: XLEquatable {
    XLComparisonExpression(.equal, lhs: lhs, rhs: rhs)
}

public func ==<T>(lhs: any {{Expression}}<T>, rhs: any {{Expression}}<Optional<T>>) -> some {{Expression}}<Optional<Bool>> where T: XLEquatable {
    XLComparisonExpression(.equal, lhs: lhs, rhs: rhs)
}

public func ==<Wrapped>(lhs: any {{Expression}}<Optional<Wrapped>>, rhs: any {{Expression}}<Wrapped>) -> some {{Expression}}<Optional<Bool>> where Wrapped: XLEquatable {
    XLComparisonExpression(.equal, lhs: lhs, rhs: rhs)
}

public func ==<Wrapped>(lhs: any {{Expression}}<Optional<Wrapped>>, rhs: any {{Expression}}<Optional<Wrapped>>) -> some {{Expression}}<Optional<Bool>> where Wrapped: XLEquatable {
    XLComparisonExpression(.equal, lhs: lhs, rhs: rhs)
}


// MARK: - Inequality


public func !=<T>(lhs: any {{Expression}}<T>, rhs: any {{Expression}}<T>) -> some {{Expression}}<Bool> where T: XLEquatable {
    XLComparisonExpression(.notEqual, lhs: lhs, rhs: rhs)
}

public func !=<T>(lhs: any {{Expression}}<T>, rhs: any {{Expression}}<Optional<T>>) -> some {{Expression}}<Optional<Bool>> where T: XLEquatable {
    XLComparisonExpression(.notEqual, lhs: lhs, rhs: rhs)
}

public func !=<Wrapped>(lhs: any {{Expression}}<Optional<Wrapped>>, rhs: any {{Expression}}<Wrapped>) -> some {{Expression}}<Optional<Bool>> where Wrapped: XLEquatable {
    XLComparisonExpression(.notEqual, lhs: lhs, rhs: rhs)
}

public func !=<Wrapped>(lhs: any {{Expression}}<Optional<Wrapped>>, rhs: any {{Expression}}<Optional<Wrapped>>) -> some {{Expression}}<Optional<Bool>> where Wrapped: XLEquatable{
    XLComparisonExpression(.notEqual, lhs: lhs, rhs: rhs)
}


// MARK: - NULL-safe comparison
//
// These treat `NULL` as a comparable value, so they yield `true` or `false`
// and never `NULL`. SQLite spells them `IS` and `IS NOT`; standard SQL spells
// them `IS NOT DISTINCT FROM` and `IS DISTINCT FROM`. The dialect's vocabulary
// decides the text (issue #692).

extension {{Expression}} where T: XLEquatable {

    /// Returns whether this value equals the other, treating two `NULL`s as equal.
    public func isNotDistinctFrom(_ other: any {{Expression}}<T>) -> some {{Expression}}<Bool> {
        XLComparisonExpression<Bool>(.nullSafeEqual, lhs: self, rhs: other)
    }

    /// Returns whether this value equals the other, treating two `NULL`s as equal.
    public func isNotDistinctFrom(_ other: any {{Expression}}<Optional<T>>) -> some {{Expression}}<Bool> {
        XLComparisonExpression<Bool>(.nullSafeEqual, lhs: self, rhs: other)
    }

    /// Returns whether this value differs from the other, treating two `NULL`s as equal.
    public func isDistinctFrom(_ other: any {{Expression}}<T>) -> some {{Expression}}<Bool> {
        XLComparisonExpression<Bool>(.nullSafeNotEqual, lhs: self, rhs: other)
    }

    /// Returns whether this value differs from the other, treating two `NULL`s as equal.
    public func isDistinctFrom(_ other: any {{Expression}}<Optional<T>>) -> some {{Expression}}<Bool> {
        XLComparisonExpression<Bool>(.nullSafeNotEqual, lhs: self, rhs: other)
    }
}


extension {{Expression}} {

    /// Returns whether this nullable value equals the other, treating two `NULL`s as equal.
    public func isNotDistinctFrom<Wrapped>(_ other: any {{Expression}}<Wrapped>) -> some {{Expression}}<Bool> where T == Optional<Wrapped>, Wrapped: XLEquatable {
        XLComparisonExpression<Bool>(.nullSafeEqual, lhs: self, rhs: other)
    }

    /// Returns whether this nullable value equals the other, treating two `NULL`s as equal.
    public func isNotDistinctFrom<Wrapped>(_ other: any {{Expression}}<Optional<Wrapped>>) -> some {{Expression}}<Bool> where T == Optional<Wrapped>, Wrapped: XLEquatable {
        XLComparisonExpression<Bool>(.nullSafeEqual, lhs: self, rhs: other)
    }

    /// Returns whether this nullable value differs from the other, treating two `NULL`s as equal.
    public func isDistinctFrom<Wrapped>(_ other: any {{Expression}}<Wrapped>) -> some {{Expression}}<Bool> where T == Optional<Wrapped>, Wrapped: XLEquatable {
        XLComparisonExpression<Bool>(.nullSafeNotEqual, lhs: self, rhs: other)
    }

    /// Returns whether this nullable value differs from the other, treating two `NULL`s as equal.
    public func isDistinctFrom<Wrapped>(_ other: any {{Expression}}<Optional<Wrapped>>) -> some {{Expression}}<Bool> where T == Optional<Wrapped>, Wrapped: XLEquatable {
        XLComparisonExpression<Bool>(.nullSafeNotEqual, lhs: self, rhs: other)
    }
}
