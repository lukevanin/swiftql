import Foundation


extension {{Expression}} {
    
    
    public func abs() -> some {{Expression}}<T> where T: Numeric & XLLiteral {
        XLFunction(name: "ABS", parameters: [self])
    }
}


extension {{Expression}} {
    
    public func rounded() -> some {{Expression}}<T> where T == Double, T: XLLiteral {
        XLFunction(name: "ROUND", parameters: [self])
    }
    

    public func rounded() -> some {{Expression}}<T> where T == Optional<Double>, T: XLLiteral {
        XLFunction(name: "ROUND", parameters: [self])
    }
}


extension {{Expression}} {

    
    public func rounded(to places: Int) -> some {{Expression}}<T> where T == Double, T: XLLiteral {
        XLFunction(name: "ROUND", parameters: [self, places])
    }
}


extension {{Expression}} {
    
    
    public func floor() -> some {{Expression}}<T> where T == Double, T: XLLiteral {
        XLFunction(name: "FLOOR", parameters: [self])
    }
}
