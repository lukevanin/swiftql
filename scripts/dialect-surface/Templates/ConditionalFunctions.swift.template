import Foundation


// MARK: - IIF


@available(*, deprecated, message: "Use condition.iif(then:else:) instead. iif(_:then:else:) will be removed in SwiftQL 2.")
public func iif<T, U>(_ condition: any {{Expression}}<U>, then: any {{Expression}}<T>, else: any {{Expression}}<T>) -> some {{Expression}}<T> where U: XLBoolean {
    XLIfExpression(condition: condition, trueResult: then, falseResult: `else`)
}


@available(*, deprecated, message: "Use condition.iif(then:else:) instead. iif(_:then:else:) will be removed in SwiftQL 2.")
public func iif<T, U>(_ condition: any {{Expression}}<U>, then: any {{Expression}}<Optional<T>>, else: any {{Expression}}<T>) -> some {{Expression}}<Optional<T>> where U: XLBoolean {
    XLIfExpression(condition: condition, trueResult: then, falseResult: `else`)
}


@available(*, deprecated, message: "Use condition.iif(then:else:) instead. iif(_:then:else:) will be removed in SwiftQL 2.")
public func iif<T, U>(_ condition: any {{Expression}}<U>, then: any {{Expression}}<T>, else: any {{Expression}}<Optional<T>>) -> some {{Expression}}<Optional<T>> where U: XLBoolean {
    XLIfExpression(condition: condition, trueResult: then, falseResult: `else`)
}


@available(*, deprecated, message: "Use condition.iif(then:else:) instead. iif(_:then:else:) will be removed in SwiftQL 2.")
public func iif<T, U>(_ condition: any {{Expression}}<U>, then: any {{Expression}}<Optional<T>>, else: any {{Expression}}<Optional<T>>) -> some {{Expression}}<Optional<T>> where U: XLBoolean {
    XLIfExpression(condition: condition, trueResult: then, falseResult: `else`)
}


extension {{Expression}} where T: XLBoolean {

    /// Returns `then` when `self` is true, `else` otherwise.
    public func iif<V>(then: any {{Expression}}<V>, else: any {{Expression}}<V>) -> some {{Expression}}<V> {
        XLIfExpression(condition: self, trueResult: then, falseResult: `else`)
    }

    /// Returns `then` when `self` is true, `else` otherwise.
    public func iif<V>(then: any {{Expression}}<Optional<V>>, else: any {{Expression}}<V>) -> some {{Expression}}<Optional<V>> {
        XLIfExpression(condition: self, trueResult: then, falseResult: `else`)
    }

    /// Returns `then` when `self` is true, `else` otherwise.
    public func iif<V>(then: any {{Expression}}<V>, else: any {{Expression}}<Optional<V>>) -> some {{Expression}}<Optional<V>> {
        XLIfExpression(condition: self, trueResult: then, falseResult: `else`)
    }

    /// Returns `then` when `self` is true, `else` otherwise.
    public func iif<V>(then: any {{Expression}}<Optional<V>>, else: any {{Expression}}<Optional<V>>) -> some {{Expression}}<Optional<V>> {
        XLIfExpression(condition: self, trueResult: then, falseResult: `else`)
    }
}
