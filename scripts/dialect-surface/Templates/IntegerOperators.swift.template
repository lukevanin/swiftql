import Foundation


// MARK: - Bitwise NOT


public prefix func ~<T>(operand: any {{Expression}}<T>) -> some {{Expression}}<T> where T: BinaryInteger {
    XLUnaryOperatorExpression(op: "~", operand: operand)
}

public prefix func ~<Wrapped>(operand: any {{Expression}}<Optional<Wrapped>>) -> some {{Expression}}<Optional<Wrapped>> where Wrapped: BinaryInteger {
    XLUnaryOperatorExpression(op: "~", operand: operand)
}


// MARK: - Addition


public func +<T>(lhs: any {{Expression}}<T>, rhs: any {{Expression}}<T>) -> some {{Expression}}<T> where T: BinaryInteger {
    XLBinaryOperatorExpression(op: "+", lhs: lhs, rhs: rhs)
}

