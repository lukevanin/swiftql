//
//  NumericOperators.swift.template
//
//  Unary plus and negation.
//  scripts/dialect-surface/generate.py renders it once for each dialect in
//  scripts/dialect-surface/dialects.json (issue #789).
//

import Foundation


// MARK: - Unary plus


public prefix func +<T>(operand: any {{Expression}}<T>) -> some {{Expression}}<T> where T: Numeric {
    XLUnaryOperatorExpression(op: "+", operand: operand)
}

public prefix func +<Wrapped>(operand: any {{Expression}}<Optional<Wrapped>>) -> some {{Expression}}<Optional<Wrapped>> where Wrapped: Numeric {
    XLUnaryOperatorExpression(op: "+", operand: operand)
}


// MARK: - Negate


public prefix func -<T>(operand: any {{Expression}}<T>) -> some {{Expression}}<T> where T: Numeric {
    XLUnaryOperatorExpression(op: "-", operand: operand)
}

public prefix func -<Wrapped>(operand: any {{Expression}}<Optional<Wrapped>>) -> some {{Expression}}<Optional<Wrapped>> where Wrapped: Numeric {
    XLUnaryOperatorExpression(op: "-", operand: operand)
}
