// MARK: - Order


extension Ascending where Dialect == {{Dialect}} {

    public init(@XLScalarExpressionBuilder expression: () -> any {{Expression}}) {
        self.init(_dialectSurface: expression())
    }

    public init(expression: any {{Expression}}) {
        self.init(_dialectSurface: expression)
    }
}


extension Descending where Dialect == {{Dialect}} {

    public init(@XLScalarExpressionBuilder expression: () -> any {{Expression}}) {
        self.init(_dialectSurface: expression())
    }

    public init(expression: any {{Expression}}) {
        self.init(_dialectSurface: expression)
    }
}


extension {{Expression}} {

    public func ascending() -> some XLOrderingTerm<{{Dialect}}> {
        Ascending<{{Dialect}}>(_dialectSurface: self)
    }

    public func descending() -> some XLOrderingTerm<{{Dialect}}> {
        Descending<{{Dialect}}>(_dialectSurface: self)
    }
}


