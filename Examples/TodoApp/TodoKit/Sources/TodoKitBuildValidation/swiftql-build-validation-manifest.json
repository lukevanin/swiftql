      "sql" : "SELECT \"t0\".\"id\" AS \"id\", \"t0\".\"listID\" AS \"listID\", \"t0\".\"title\" AS \"title\", \"t0\".\"notes\" AS \"notes\", \"t0\".\"dueAt\" AS \"dueAt\", \"t0\".\"priority\" AS \"priority\", \"t0\".\"isCompleted\" AS \"isCompleted\", \"t0\".\"position\" AS \"position\", \"t0\".\"createdAt\" AS \"createdAt\" FROM \"Todo\" AS \"t0\" WHERE ((((\"t0\".\"listID\" == :listID) AND ((\"t0\".\"isCompleted\" == :includesCompleted) OR (\"t0\".\"isCompleted\" != :includesActive))) AND ((:overdueOnly == 0) OR ((\"t0\".\"dueAt\" < :referenceDate) AND (\"t0\".\"isCompleted\" == 0)))) AND ((\"t0\".\"title\" LIKE :searchPattern) OR (\"t0\".\"notes\" LIKE :searchPattern))) ORDER BY IIF((:sortOrder == 1), COALESCE(\"t0\".\"dueAt\", '2100-01-01T00:00:00.000Z'), '2100-01-01T00:00:00.000Z') ASC, IIF((:sortOrder == 2), \"t0\".\"priority\", 0) DESC, IIF((:sortOrder == 0), \"t0\".\"position\", 0) ASC, \"t0\".\"title\" ASC"
